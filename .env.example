# Copy to .env.local for development, and set the same values in Vercel.
# Generate the first two with:  npm run secrets -- "your shared password"
#
# NOTE: values must not contain a bare `$` — Next expands `$VAR` when it reads
# .env files. The generated hash uses `:` separators for exactly this reason.

# scrypt hash of the shared editing password. The password itself is never stored.
EDIT_PASSWORD_HASH=""

# Random 32+ character string used to sign the session cookie.
# Changing it signs everyone out.
SESSION_SECRET=""

# --- GitHub storage -------------------------------------------------------
# Leave these unset in development: the app then reads and writes ./data
# directly, so you can work offline and inspect changes with `git diff`.
#
# In production all three are required. The token needs Contents: read & write
# on this repository only.
# GITHUB_TOKEN=""
# GITHUB_REPOSITORY="your-username/pancaketunes"
# GITHUB_BRANCH="main"
